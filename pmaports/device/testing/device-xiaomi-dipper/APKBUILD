# Reference: https://wiki.nura.eco/wiki/Device_specific_package
# Modeled on Nura pmaports device/community/device-xiaomi-beryllium
# (the closest, actively maintained SDM845 Xiaomi port).
maintainer="dipper local port <dipper@example.com>"
pkgname=device-xiaomi-dipper
pkgdesc="Xiaomi Mi 8 (dipper, 6GB+128GB)"
pkgver=1
# r5: put st_fts_e1.ftb into the initramfs too -- the controller probes
#      (and is flashed) before the real root is mounted, so the firmware
#      must travel with the initramfs or request_firmware returns -ENOENT.
# r4: ship st_fts_e1.ftb, the touch controller's firmware.  The part is
#      host-loaded: without this download it ACKs I2C but never starts
#      (every register reads back zero, no interrupts).  The kernel driver
#      requests qcom/sdm845/Xiaomi/dipper/st_fts_e1.ftb at probe and flashes
#      it with the CX (calibration) pages preserved.
# r3: ship the dipper Adreno zap shader plus the mkinitfs file list that puts
#     it into the initramfs.  The GPU probes before the real root is mounted,
#     so without this the driver failed with -ENOENT, GPU hw init was skipped
#     and the whole desktop fell back to llvmpipe (that is the lag).
# r2: ship the RNDIS gadget fixup (service+timer) and mask usb-signaller,
#     so the phone always enumerates as a USB NIC after boot.
# r1: RNDIS USB network + console=tty0/loglevel=8 for visible debug output
pkgrel=5
url="https://wiki.nura.eco/wiki/Xiaomi_Mi_8_(SDM845)_(xiaomi-dipper,_xiaomi-equuleus,_xiaomi-ursa)"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip"
depends="
	alsa-ucm-conf-sdm845
	firmware-xiaomi-beryllium
	hexagonrpcd
	linux-firmware-qcom
	linux-postmarketos-qcom-sdm845-dipper
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	usb-gadget-fixup.sh
	usb-gadget-fixup.service
	usb-gadget-fixup.timer
	a630_zap.mbn
	st_fts_e1.ftb
	00-device-xiaomi-dipper-gpu.files
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Keep the phone's USB NIC up by ourselves: write the gadget directly to
	# configfs instead of letting usb-signaller pick a mode.
	install -Dm755 "$srcdir"/usb-gadget-fixup.sh 		"$pkgdir"/usr/bin/usb-gadget-fixup.sh
	install -Dm644 "$srcdir"/usb-gadget-fixup.service 		"$pkgdir"/etc/systemd/system/usb-gadget-fixup.service
	install -Dm644 "$srcdir"/usb-gadget-fixup.timer 		"$pkgdir"/etc/systemd/system/usb-gadget-fixup.timer

	# Adreno zap shader for this panel/board combination, plus the mkinitfs
	# file list that pulls the GPU firmware into the initramfs.
	install -Dm644 "$srcdir"/a630_zap.mbn \
		"$pkgdir"/usr/lib/firmware/qcom/sdm845/Xiaomi/dipper/a630_zap.mbn
	install -Dm644 "$srcdir"/st_fts_e1.ftb \
		"$pkgdir"/usr/lib/firmware/qcom/sdm845/Xiaomi/dipper/st_fts_e1.ftb
	install -Dm644 "$srcdir"/00-device-xiaomi-dipper-gpu.files \
		"$pkgdir"/usr/share/mkinitfs/files/00-device-xiaomi-dipper-gpu.files
}

