+
+static int stmfts5_write_buf(struct stmfts_data *sdata, const u8 *buf, u16 len)
+{
+	struct i2c_msg msg = {
+		.addr	= sdata->client->addr,
+		.len	= len,
+		.buf	= (char *)buf,
+	};
+	int ret;
+
+	ret = i2c_transfer(sdata->client->adapter, &msg, 1);
+	if (ret < 0)
+		return ret;
+
+	return ret == 1 ? 0 : -EIO;
+}
+
+/*
+ * r94 arm sequence: 0x91 SLEEP_OUT -> 0xa0 0x00 0xff scan-mode ->
+ * 0x93 single-byte sense-on -> IER(0x002c)=0x41.  All four are required.
+ */
+static int stmfts5_set_scan(struct stmfts_data *sdata, bool enable)
+{
+	u8 scan_mode_cmd[3] = { STMFTS5_SET_SCAN_MODE,
+				STMFTS5_SCAN_MODE_ACTIVE,
+				enable ? 0x01 : 0x00 };
+	int err;
+
+	err = stmfts5_write_buf(sdata, scan_mode_cmd, sizeof(scan_mode_cmd));
+	if (err || !enable)
+		return err;
+
+	/* sense-on: 0xa0 0x00 0x01 (multi-touch scan). The 0xff variant
+	 * enables extra scan modes and breaks touch on this panel.
+	 */
+	return 0;
+}
+
+static int stmfts5_hw_reg_write(struct stmfts_data *sdata, u16 addr, u8 val)
+{
+	u8 cmd[4] = { STMFTS5_HW_REG_W, (u8)(addr >> 8), (u8)addr, val };
+
+	return stmfts5_write_buf(sdata, cmd, sizeof(cmd));
+}
+
+/*
+ * wait_for_flash_ready(): write {0xf9, type} and poll one status byte until
+ * bit 7 clears.
+ */
+static int stmfts5_flash_wait_ready(struct stmfts_data *sdata, u8 type)
+{
+	u8 cmd[2] = { STMFTS5_FLASH_READ_REG, type };
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		struct i2c_msg msgs[2] = {
+			{ .addr	= sdata->client->addr, .len = 2, .buf = (char *)cmd },
+			{ .addr	= sdata->client->addr, .flags = I2C_M_RD, .len = 1,
+			  .buf	= (char *)&sdata->data[0] },
+		};
+		int ret = i2c_transfer(sdata->client->adapter, msgs, 2);
+
+		if (ret == 2 && !(sdata->data[0] & 0x80))
+			return 0;
+
+		usleep_range(8000, 10000);
+	}
+
+	dev_err(&sdata->client->dev,
+		"flash wait type %#02x timed out, last status %#02x\n",
+		type, sdata->data[0]);
+	return -ETIMEDOUT;
+}
+
+/* GPIO reset pulse, then wait for CONTROL_READY (0x03 or 0x10). */
+static int stmfts5_system_reset(struct stmfts_data *sdata)
+{
+	int i, j;
+
+	stmfts_reset(sdata);
+
+	for (i = 0; i < 100; i++) {
+		msleep(10);
+
+		if (stmfts_read_events(sdata) <= 0)
+			continue;
+
+		for (j = 0; j < sdata->events; j++) {
+			u8 id = sdata->data[j * STMFTS_EVENT_SIZE];
+
+			if (id == STMFTS_EV_CONTROLLER_READY ||
+			    id == STMFTS5_EV_CONTROLLER_READY)
+				return 0;
+		}
+	}
+
+	return -ETIMEDOUT;
+}
