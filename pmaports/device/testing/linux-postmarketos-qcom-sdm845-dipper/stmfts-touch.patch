+/*
+ * fillFlash(): push up to 64 KiB with 0xf8 writes of 512 bytes, then let the
+ * DMA engine copy the window into flash.
+ */
+static int stmfts5_flash_fill(struct stmfts_data *sdata, u32 address,
+			      const u8 *data, size_t size)
+{
+	size_t remaining = size;
+	size_t offset = 0;
+	int wheel = 0;
+	u8 cmd[9];
+	int err;
+
+	while (remaining > 0) {
+		size_t block = 0;
+		u16 addr = 0;
+
+		while (block < STMFTS5_FLASH_CHUNK && remaining > 0) {
+			size_t to_write;
+			u8 chunk[STMFTS5_FLASH_DMA_CHUNK + 3];
+
+			if (remaining >= STMFTS5_FLASH_DMA_CHUNK &&
+			    block + STMFTS5_FLASH_DMA_CHUNK <= STMFTS5_FLASH_CHUNK) {
+				to_write = STMFTS5_FLASH_DMA_CHUNK;
+			} else {
+				to_write = min(remaining, STMFTS5_FLASH_CHUNK - block);
+			}
+
+			chunk[0] = STMFTS5_FLASH_WRITE_64K;
+			chunk[1] = (u8)(addr >> 8);
+			chunk[2] = (u8)addr;
+			memcpy(&chunk[3], data + offset, to_write);
+
+			err = stmfts5_write_buf(sdata, chunk, 3 + to_write);
+			if (err)
+				return err;
+
+			addr += to_write;
+			offset += to_write;
+			block += to_write;
+			remaining -= to_write;
+		}
+
+		{
+			u32 words = (u32)(block / 4 - 1);
+			u32 dma_addr = address + ((u32)wheel * STMFTS5_FLASH_CHUNK) / 4;
+
+			dev_info(&sdata->client->dev,
+				 "flash fill: wheel %d, addr %#08x, words %u\n",
+				 wheel, dma_addr, words);
+
+			cmd[0] = STMFTS5_FLASH_WRITE_REG;
+			cmd[1] = STMFTS5_FLASH_DMA_CFG;
+			cmd[2] = 0x00;
+			cmd[3] = 0x00;
+			cmd[4] = (u8)(dma_addr & 0xff);
+			cmd[5] = (u8)((dma_addr >> 8) & 0xff);
+			cmd[6] = (u8)(words & 0xff);
+			cmd[7] = (u8)((words >> 8) & 0xff);
+			cmd[8] = 0x00;
+
+			err = stmfts5_write_buf(sdata, cmd, sizeof(cmd));
+			if (err)
+				return err;
+		}
+
+		{
+			u8 start[3] = { STMFTS5_FLASH_WRITE_REG,
+					STMFTS5_FLASH_DMA_START0,
+					STMFTS5_FLASH_DMA_START1 };
+
+			err = stmfts5_write_buf(sdata, start, sizeof(start));
+			if (err)
+				return err;
+		}
+
+		err = stmfts5_flash_wait_ready(sdata, STMFTS5_FLASH_DMA_TYPE);
+		if (err)
+			return err;
+
+		wheel++;
+	}
+
+	return 0;
+}
