+/*
+ * flash_burn() with keep_cx = 1: erase every page except the two calibration
+ * pages, then write code and config sections from the firmware file.
+ */
+static int stmfts5_flash_firmware(struct stmfts_data *sdata,
+				  const struct firmware *fw)
+{
+	const u8 *data = fw->data;
+	size_t len = fw->size;
+	u32 sec0, sec1;
+	const u8 *body;
+	u8 cmd[3];
+	int err, page;
+
+	/* the .ftb signature is read little endian by the downstream parser */
+	if (len < 64 + 8 || data[0] != 0x55 || data[1] != 0xaa ||
+	    data[2] != 0x55 || data[3] != 0xaa) {
+		dev_err(&sdata->client->dev, "bad firmware header\n");
+		return -EINVAL;
+	}
+
+	sec0 = data[44] | (data[45] << 8) | (data[46] << 16) |
+	       ((u32)data[47] << 24);
+	sec1 = data[48] | (data[49] << 8) | (data[50] << 16) |
+	       ((u32)data[51] << 24);
+	body = &data[64];
+
+	if (sec0 + sec1 + 64 + 4 > len) {
+		dev_err(&sdata->client->dev,
+			"firmware size mismatch: %u + %u\n", sec0, sec1);
+		return -EINVAL;
+	}
+
+	dev_info(&sdata->client->dev,
+		 "downloading firmware: %u B code, %u B config\n",
+		 sec0, sec1);
+
+	/* 2) warm boot */
+	err = stmfts5_hw_reg_write(sdata, STMFTS5_WARM_BOOT_REG,
+				   STMFTS5_WARM_BOOT_VALUE);
+	if (err)
+		return err;
+
+	/* 3) flash unlock */
+	cmd[0] = STMFTS5_FLASH_UNLOCK;
+	cmd[1] = STMFTS5_FLASH_UNLOCK_K0;
+	cmd[2] = STMFTS5_FLASH_UNLOCK_K1;
+	err = stmfts5_write_buf(sdata, cmd, 3);
+	if (err)
+		return err;
+
+	/* 4) erase unlock */
+	cmd[0] = STMFTS5_FLASH_WRITE_REG;
+	cmd[1] = STMFTS5_FLASH_ERASE_UK0;
+	cmd[2] = STMFTS5_FLASH_ERASE_UK1;
+	err = stmfts5_write_buf(sdata, cmd, 3);
+	if (err)
+		return err;
+
+	/* 5) erase page by page, keeping the calibration pages; the erase
+	 *    command carries a trailing zero byte in the downstream driver
+	 */
+	for (page = 0; page < STMFTS5_FLASH_NUM_PAGE; page++) {
+		u8 erase[4] = { STMFTS5_FLASH_WRITE_REG,
+				STMFTS5_FLASH_ERASE_TYPE, 0x00, 0x00 };
+
+		if (page >= STMFTS5_FLASH_CX_FIRST && page <= STMFTS5_FLASH_CX_LAST)
+			continue;
+
+		erase[2] = (0x3f & page) | STMFTS5_FLASH_ERASE_START;
+
+		err = stmfts5_write_buf(sdata, erase, sizeof(erase));
+		if (err)
+			return err;
+
+		err = stmfts5_flash_wait_ready(sdata, STMFTS5_FLASH_ERASE_TYPE);
+		if (err) {
+			dev_err(&sdata->client->dev,
+				"erase of page %d failed: %d\n", page, err);
+			return err;
+		}
+	}
+
+	/* 6) code, 7) config */
+	err = stmfts5_flash_fill(sdata, STMFTS5_FLASH_ADDR_CODE, body, sec0);
+	if (err)
+		return err;
+
+	err = stmfts5_flash_fill(sdata, STMFTS5_FLASH_ADDR_CONFIG,
+				 body + sec0, sec1);
+	if (err)
+		return err;
+
+	/* 8) system reset so the freshly written image starts */
+	err = stmfts5_system_reset(sdata);
+
+	return err;
+}
+
+/*
+ * Arm the interrupt sources the downstream driver uses.  Without this the
+ * touch event source stays masked and only status updates get through.
+ */
+static int stmfts5_chip_enable(struct stmfts_data *sdata)
+{
+	stmfts5_flush_fifo(sdata);
+
+	return stmfts5_hw_reg_write(sdata, 0x002c, (u8)ier_mask);
+}
+
+/* probe-time bring-up: reset, download the firmware if dead, arm. */
+static int stmfts5_bring_up(struct stmfts_data *sdata)
+{
+	const struct firmware *fw = NULL;
+	int err;
+
+	err = stmfts5_system_reset(sdata);
+	if (!err)
+		return stmfts5_chip_enable(sdata);
+
+	if (!fw_download) {
+		dev_warn(&sdata->client->dev, "no CONTROL_READY after reset\n");
+		return stmfts5_chip_enable(sdata);
+	}
+
+	dev_info(&sdata->client->dev,
+		 "no CONTROL_READY after reset, downloading firmware\n");
+
+	err = request_firmware(&fw, STMFTS5_FW_NAME, &sdata->client->dev);
+	if (err) {
+		dev_err(&sdata->client->dev,
+			"firmware %s unavailable: %d\n", STMFTS5_FW_NAME, err);
+		return stmfts5_chip_enable(sdata);
+	}
+
+	err = stmfts5_flash_firmware(sdata, fw);
+	release_firmware(fw);
+	if (err) {
+		dev_err(&sdata->client->dev, "firmware download failed: %d\n", err);
+		return stmfts5_chip_enable(sdata);
+	}
+
+	err = stmfts5_system_reset(sdata);
+	if (err)
+		dev_warn(&sdata->client->dev,
+			 "no CONTROL_READY after firmware download\n");
+
+	return stmfts5_chip_enable(sdata);
+}
+
+/*
+ * Drain the whole event FIFO.  It holds 64 events, and stale events from
+ * before a reset or a reopen are re-delivered to the first reader otherwise --
+ * the old contacts then show up as ghost touches.  An empty FIFO answers with
+ * all-zero bytes.
+ */
+static void stmfts5_flush_fifo(struct stmfts_data *sdata)
+{
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		memset(sdata->data, 0, STMFTS_DATA_MAX_SIZE);
+
+		if (stmfts_read_events(sdata))
+			return;
+
+		if (!sdata->data[0])
+			return;
+	}
+}
