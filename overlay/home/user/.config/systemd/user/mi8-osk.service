[Unit]
Description=Enable on-screen keyboard (focus driven)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true

[Install]
WantedBy=graphical-session.target
