# Mi 8: UCM verb fails to import on this rootfs, so bind the PCMs directly.
# Speaker/music: MultiMedia1 (hw:0,0) -> QUAT_MI2S_RX -> TAS2557
# Mic:           MultiMedia3 (hw:0,2) -> SLIMBUS_0_TX
load-module module-alsa-sink   device=hw:0,0 sink_name=mi8_speaker tsched=0
load-module module-alsa-source device=hw:0,2 source_name=mi8_mic    tsched=0
set-default-sink   mi8_speaker
set-default-source mi8_mic
